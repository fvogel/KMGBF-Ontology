{
  "@context": {
    "dct": "http://purl.org/dc/terms/",
    "owl": "http://www.w3.org/2002/07/owl#",
    "rdf": "http://www.w3.org/1999/02/22-rdf-syntax-ns#",
    "rdfs": "http://www.w3.org/2000/01/rdf-schema#",
    "schema": "http://schema.org/",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "xsd": "http://www.w3.org/2001/XMLSchema#"
  },
  "@graph": [
    {
      "@id": "_:cbd5cac84c7054686b699241e497ecf6aba0bf59d2ec2f596e450d43a8a92df2f5",
      "@type": "owl:Class",
      "owl:unionOf": {
        "@list": [
          {
            "@id": "http://metadata.cbd.int/kmgbf/ontology#Goal"
          },
          {
            "@id": "http://metadata.cbd.int/kmgbf/ontology#Target"
          }
        ]
      }
    },
    {
      "@id": "dct:subject",
      "@type": "owl:ObjectProperty",
      "rdfs:domain": {
        "@id": "skos:Concept"
      },
      "rdfs:range": {
        "@id": "skos:Concept"
      }
    },
    {
      "@id": "http://metadata.cbd.int/kmgbf/ontology",
      "@type": "owl:Ontology",
      "dct:created": {
        "@type": "xsd:date",
        "@value": "2026-01-29"
      },
      "dct:creator": "Convention on Biological Diversity Secretariat",
      "dct:modified": {
        "@type": "xsd:date",
        "@value": "2026-10-22"
      },
      "owl:versionInfo": "1.0.2",
      "rdfs:comment": {
        "@language": "en",
        "@value": "Official ontology for the monitoring framework of the Kunming-Montreal Global Biodiversity Framework adopted at COP-15 in December 2022. Based on Decision 16/31 (February 2025) on indicators for the monitoring framework. Goals and Targets are parallel concepts at the same hierarchical level, both monitored by indicators."
      },
      "rdfs:label": [
        {
          "@language": "en",
          "@value": "Kunming-Montreal Global Biodiversity Framework Ontology"
        },
        {
          "@language": "es",
          "@value": "Ontología del Marco Mundial de Biodiversidad de Kunming-Montreal"
        },
        {
          "@language": "fr",
          "@value": "Ontologie du Cadre mondial de la biodiversité de Kunming-Montréal"
        }
      ],
      "rdfs:seeAlso": [
        {
          "@id": "https://www.cbd.int/doc/decisions/cop-16/cop-16-dec-31-en.pdf"
        },
        {
          "@id": "https://www.cbd.int/gbf"
        }
      ],
      "skos:note": {
        "@language": "en",
        "@value": "Note on SKOS compatibility: The triplestore serving this ontology contains additional skos:broader/skos:narrower triples linking indicators to goals and targets. These are NOT part of this OWL model — they are materialized by the data loading pipeline solely to enable browsing in SKOSMOS, which requires a SKOS hierarchy. The canonical relationships defined here are :isHeadlineFor, :isBinaryFor, :isComponentFor, and :isComplementaryFor. These role-typed properties correctly express that a single indicator can have different roles for different goals or targets — a fact that a flat skos:broader hierarchy cannot represent."
      }
    },
    {
      "@id": "http://metadata.cbd.int/kmgbf/ontology#Goal",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "One of the four 2050 outcome-oriented Goals (A, B, C, D) of the Kunming-Montreal Global Biodiversity Framework. Goals describe desired states of nature and biodiversity by 2050. Goals and Targets are parallel concepts at the same hierarchical level - they are not in a hierarchical relationship."
      },
      "rdfs:label": [
        {
          "@language": "en",
          "@value": "Goal"
        },
        {
          "@language": "es",
          "@value": "Objetivo"
        },
        {
          "@language": "fr",
          "@value": "Objectif"
        }
      ],
      "rdfs:subClassOf": {
        "@id": "skos:Concept"
      },
      "skos:example": {
        "@language": "en",
        "@value": "Goal A: The integrity, connectivity and resilience of all ecosystems are maintained, enhanced, or restored..."
      }
    },
    {
      "@id": "http://metadata.cbd.int/kmgbf/ontology#GoalOrTarget",
      "@type": "owl:Class",
      "owl:equivalentClass": {
        "@id": "_:cbd5cac84c7054686b699241e497ecf6aba0bf59d2ec2f596e450d43a8a92df2f5"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Convenience class representing the union of Goal and Target."
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "Goal or Target"
      }
    },
    {
      "@id": "http://metadata.cbd.int/kmgbf/ontology#Indicator",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "A metric used to monitor progress toward goals and/or targets. An indicator's role (headline, binary, component, complementary) is determined by its relationship to goals/targets, not by its intrinsic type. A single indicator can play different roles for different goals or targets (e.g., indicator 7.1 is a headline indicator for Target 7 and a complementary indicator for Target 8)."
      },
      "rdfs:label": [
        {
          "@language": "en",
          "@value": "Indicator"
        },
        {
          "@language": "es",
          "@value": "Indicador"
        },
        {
          "@language": "fr",
          "@value": "Indicateur"
        }
      ],
      "rdfs:subClassOf": {
        "@id": "skos:Concept"
      },
      "skos:example": {
        "@language": "en",
        "@value": "Indicator 7.1 is headline for Target 7 and complementary for Target 8"
      }
    },
    {
      "@id": "http://metadata.cbd.int/kmgbf/ontology#Target",
      "@type": "owl:Class",
      "rdfs:comment": {
        "@language": "en",
        "@value": "One of the 23 action-oriented targets for 2030 under the Kunming-Montreal Global Biodiversity Framework. Targets describe specific actions and milestones to be achieved by 2030. Goals and Targets are parallel concepts at the same hierarchical level - they are not in a hierarchical relationship."
      },
      "rdfs:label": [
        {
          "@language": "en",
          "@value": "Target"
        },
        {
          "@language": "es",
          "@value": "Meta"
        },
        {
          "@language": "fr",
          "@value": "Cible"
        }
      ],
      "rdfs:subClassOf": {
        "@id": "skos:Concept"
      },
      "skos:example": {
        "@language": "en",
        "@value": "Target 3: Ensure and enable that by 2030 at least 30 per cent of terrestrial, inland water, and of coastal and marine areas... are effectively conserved and managed..."
      }
    },
    {
      "@id": "http://metadata.cbd.int/kmgbf/ontology#custodianAgency",
      "@type": "owl:DatatypeProperty",
      "rdfs:comment": {
        "@language": "en",
        "@value": "The international organization responsible for compiling and reporting data for this indicator, as designated in the KMGBF monitoring framework guidance (CBD/COP/16/INF/3/Rev.1, field 10a). Parallel to sdg:custodianAgency in the UN SDG ontology."
      },
      "rdfs:domain": {
        "@id": "http://metadata.cbd.int/kmgbf/ontology#Indicator"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "custodian agency"
      },
      "rdfs:range": {
        "@id": "xsd:string"
      },
      "skos:example": {
        "@language": "en",
        "@value": "International Union for Conservation of Nature (IUCN)"
      }
    },
    {
      "@id": "http://metadata.cbd.int/kmgbf/ontology#goalCode",
      "@type": "owl:DatatypeProperty",
      "rdfs:comment": {
        "@language": "en",
        "@value": "The letter identifier for the goal. Must be one of: A, B, C, or D."
      },
      "rdfs:domain": {
        "@id": "http://metadata.cbd.int/kmgbf/ontology#Goal"
      },
      "rdfs:label": [
        {
          "@language": "en",
          "@value": "goal code"
        },
        {
          "@language": "es",
          "@value": "código del objetivo"
        },
        {
          "@language": "fr",
          "@value": "code de l'objectif"
        }
      ],
      "rdfs:range": {
        "@id": "xsd:string"
      },
      "rdfs:subPropertyOf": {
        "@id": "skos:notation"
      },
      "skos:example": {
        "@language": "en",
        "@value": "A, B, C, D"
      }
    },
    {
      "@id": "http://metadata.cbd.int/kmgbf/ontology#hasBinaryIndicator",
      "@type": "owl:ObjectProperty",
      "rdfs:comment": {
        "@language": "en",
        "@value": "Inverse of isBinaryFor: links a goal or target to its binary indicator(s)."
      },
      "rdfs:domain": {
        "@id": "http://metadata.cbd.int/kmgbf/ontology#GoalOrTarget"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "has binary indicator"
      },
      "rdfs:range": {
        "@id": "http://metadata.cbd.int/kmgbf/ontology#Indicator"
      }
    },
    {
      "@id": "http://metadata.cbd.int/kmgbf/ontology#hasComplementaryIndicator",
      "@type": "owl:ObjectProperty",
      "rdfs:comment": {
        "@language": "en",
        "@value": "Inverse of isComplementaryFor: links a goal or target to its complementary indicator(s)."
      },
      "rdfs:domain": {
        "@id": "http://metadata.cbd.int/kmgbf/ontology#GoalOrTarget"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "has complementary indicator"
      },
      "rdfs:range": {
        "@id": "http://metadata.cbd.int/kmgbf/ontology#Indicator"
      }
    },
    {
      "@id": "http://metadata.cbd.int/kmgbf/ontology#hasComponentIndicator",
      "@type": "owl:ObjectProperty",
      "rdfs:comment": {
        "@language": "en",
        "@value": "Inverse of isComponentFor: links a goal or target to its component indicator(s)."
      },
      "rdfs:domain": {
        "@id": "http://metadata.cbd.int/kmgbf/ontology#GoalOrTarget"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "has component indicator"
      },
      "rdfs:range": {
        "@id": "http://metadata.cbd.int/kmgbf/ontology#Indicator"
      }
    },
    {
      "@id": "http://metadata.cbd.int/kmgbf/ontology#hasHeadlineIndicator",
      "@type": "owl:ObjectProperty",
      "rdfs:comment": {
        "@language": "en",
        "@value": "Inverse of isHeadlineFor: links a goal or target to its headline indicator(s)."
      },
      "rdfs:domain": {
        "@id": "http://metadata.cbd.int/kmgbf/ontology#GoalOrTarget"
      },
      "rdfs:label": {
        "@language": "en",
        "@value": "has headline indicator"
      },
      "rdfs:range": {
        "@id": "http://metadata.cbd.int/kmgbf/ontology#Indicator"
      }
    },
    {
      "@id": "http://metadata.cbd.int/kmgbf/ontology#indicatorCode",
      "@type": "owl:DatatypeProperty",
      "rdfs:comment": {
        "@language": "en",
        "@value": "The unique identifier for the indicator following official patterns: {Goal/Target}.{number} for headline (e.g., A.1, 1.1), {Goal/Target}.b for binary (e.g., B.b, 1.b), {Goal/Target}.CT.{number} for component (e.g., A.CT.1, 2.CT.1), {Goal/Target}.CY.{number} for complementary (e.g., A.CY.1, 1.CY.1)."
      },
      "rdfs:domain": {
        "@id": "http://metadata.cbd.int/kmgbf/ontology#Indicator"
      },
      "rdfs:label": [
        {
          "@language": "en",
          "@value": "indicator code"
        },
        {
          "@language": "es",
          "@value": "código del indicador"
        },
        {
          "@language": "fr",
          "@value": "code de l'indicateur"
        }
      ],
      "rdfs:range": {
        "@id": "xsd:string"
      },
      "rdfs:subPropertyOf": {
        "@id": "skos:notation"
      },
      "skos:example": {
        "@language": "en",
        "@value": "A.1, 1.1, B.b, 1.b, A.CT.1, 2.CT.1, A.CY.1, 1.CY.1"
      }
    },
    {
      "@id": "http://metadata.cbd.int/kmgbf/ontology#isBinaryFor",
      "@type": "owl:ObjectProperty",
      "owl:inverseOf": {
        "@id": "http://metadata.cbd.int/kmgbf/ontology#hasBinaryIndicator"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Links an indicator to the goal(s) or target(s) for which it serves as a binary indicator. Binary indicators are policy and action indicators with structured yes/no questions that all Parties are requested to respond to (Annex I of Decision 16/31)."
      },
      "rdfs:domain": {
        "@id": "http://metadata.cbd.int/kmgbf/ontology#Indicator"
      },
      "rdfs:label": [
        {
          "@language": "en",
          "@value": "is binary indicator for"
        },
        {
          "@language": "es",
          "@value": "es indicador binario para"
        },
        {
          "@language": "fr",
          "@value": "est l'indicateur binaire pour"
        }
      ],
      "rdfs:range": {
        "@id": "http://metadata.cbd.int/kmgbf/ontology#GoalOrTarget"
      },
      "skos:example": {
        "@language": "en",
        "@value": "Indicator 1.b is binary for Target 1"
      }
    },
    {
      "@id": "http://metadata.cbd.int/kmgbf/ontology#isComplementaryFor",
      "@type": "owl:ObjectProperty",
      "owl:inverseOf": {
        "@id": "http://metadata.cbd.int/kmgbf/ontology#hasComplementaryIndicator"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Links an indicator to the goal(s) or target(s) for which it serves as a complementary indicator. Complementary indicators are optional and provide additional context (Annex II of Decision 16/31). Use is subject to national circumstances and priorities."
      },
      "rdfs:domain": {
        "@id": "http://metadata.cbd.int/kmgbf/ontology#Indicator"
      },
      "rdfs:label": [
        {
          "@language": "en",
          "@value": "is complementary indicator for"
        },
        {
          "@language": "es",
          "@value": "es indicador complementario para"
        },
        {
          "@language": "fr",
          "@value": "est l'indicateur complémentaire pour"
        }
      ],
      "rdfs:range": {
        "@id": "http://metadata.cbd.int/kmgbf/ontology#GoalOrTarget"
      },
      "skos:example": {
        "@language": "en",
        "@value": "Indicator A.CY.1 is complementary for Goal A; Indicator 7.1 is complementary for Target 8"
      }
    },
    {
      "@id": "http://metadata.cbd.int/kmgbf/ontology#isComponentFor",
      "@type": "owl:ObjectProperty",
      "owl:inverseOf": {
        "@id": "http://metadata.cbd.int/kmgbf/ontology#hasComponentIndicator"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Links an indicator to the goal(s) or target(s) for which it serves as a component indicator. Component indicators are optional and provide specific detail on components of headline indicators (Annex II of Decision 16/31). Use is subject to national circumstances and priorities."
      },
      "rdfs:domain": {
        "@id": "http://metadata.cbd.int/kmgbf/ontology#Indicator"
      },
      "rdfs:label": [
        {
          "@language": "en",
          "@value": "is component indicator for"
        },
        {
          "@language": "es",
          "@value": "es indicador de componente para"
        },
        {
          "@language": "fr",
          "@value": "est l'indicateur de composante pour"
        }
      ],
      "rdfs:range": {
        "@id": "http://metadata.cbd.int/kmgbf/ontology#GoalOrTarget"
      },
      "skos:example": {
        "@language": "en",
        "@value": "Indicator A.CT.1 (Ecosystem Intactness Index) is component for Goal A"
      }
    },
    {
      "@id": "http://metadata.cbd.int/kmgbf/ontology#isHeadlineFor",
      "@type": "owl:ObjectProperty",
      "owl:inverseOf": {
        "@id": "http://metadata.cbd.int/kmgbf/ontology#hasHeadlineIndicator"
      },
      "rdfs:comment": {
        "@language": "en",
        "@value": "Links an indicator to the goal(s) or target(s) for which it serves as a headline indicator. Headline indicators are primary quantitative indicators that all Parties are requested to use in their national reports (Annex I of Decision 16/31)."
      },
      "rdfs:domain": {
        "@id": "http://metadata.cbd.int/kmgbf/ontology#Indicator"
      },
      "rdfs:label": [
        {
          "@language": "en",
          "@value": "is headline indicator for"
        },
        {
          "@language": "es",
          "@value": "es indicador principal para"
        },
        {
          "@language": "fr",
          "@value": "est l'indicateur principal pour"
        }
      ],
      "rdfs:range": {
        "@id": "http://metadata.cbd.int/kmgbf/ontology#GoalOrTarget"
      },
      "skos:example": {
        "@language": "en",
        "@value": "Indicator A.1 is headline for Goal A; Indicator A.1 is headline for Target 1"
      }
    },
    {
      "@id": "http://metadata.cbd.int/kmgbf/ontology#targetCode",
      "@type": "owl:DatatypeProperty",
      "rdfs:comment": {
        "@language": "en",
        "@value": "The numeric identifier for the target. Must be an integer from 1 to 23."
      },
      "rdfs:domain": {
        "@id": "http://metadata.cbd.int/kmgbf/ontology#Target"
      },
      "rdfs:label": [
        {
          "@language": "en",
          "@value": "target code"
        },
        {
          "@language": "es",
          "@value": "código de la meta"
        },
        {
          "@language": "fr",
          "@value": "code de la cible"
        }
      ],
      "rdfs:range": {
        "@id": "xsd:integer"
      },
      "rdfs:subPropertyOf": {
        "@id": "skos:notation"
      },
      "skos:example": {
        "@language": "en",
        "@value": "1, 2, 3, ..., 23"
      }
    },
    {
      "@id": "skos:notation",
      "rdfs:subPropertyOf": {
        "@id": "schema:identifier"
      }
    },
    {
      "@id": "skos:prefLabel",
      "rdfs:subPropertyOf": {
        "@id": "schema:name"
      }
    }
  ]
}
